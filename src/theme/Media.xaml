<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Prism Console additions. Playnite loads the default Media.xaml first and
        this file after it, so only new or changed resources live here.
    -->

    <!--
        Colorful platform logo for the game in DataContext (a game entry).
        Lookup order:
          1. Images/Platforms/<platform specification id>.png   (shipped with the theme)
          2. Images/Platforms/<platform name>.png               (drop your own files here)
          3. A gradient text chip with the platform name
    -->
    <Style x:Key="PC_PlatformLogo" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                        <Image x:Name="LogoById" Stretch="Uniform" StretchDirection="Both"
                               RenderOptions.BitmapScalingMode="Fant"
                               Source="{ThemeFileBinding Platforms[0].SpecificationId, PathFormat='Images/Platforms/{0}.png'}" />
                        <Image x:Name="LogoByName" Stretch="Uniform" StretchDirection="Both"
                               RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"
                               Source="{ThemeFileBinding Platforms[0].Name, PathFormat='Images/Platforms/{0}.png'}" />
                        <Border x:Name="TextChip" Visibility="Collapsed"
                                CornerRadius="8" Padding="12,2,12,2"
                                Background="{DynamicResource SelectionBrush}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Platforms[0].Name}"
                                           FontFamily="{DynamicResource FontTitilliumWebBold}"
                                           FontSize="22" Foreground="White"
                                           VerticalAlignment="Center" />
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="LogoById" Property="Source" Value="{x:Null}">
                            <Setter TargetName="LogoById" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LogoByName" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="LogoById" Property="Source" Value="{x:Null}" />
                                <Condition SourceName="LogoByName" Property="Source" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LogoByName" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TextChip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <DataTrigger Binding="{Binding Platforms.Count}" Value="0">
                            <Setter TargetName="TextChip" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Platforms}" Value="{x:Null}">
                            <Setter TargetName="TextChip" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small rounded info chip used in the hero area -->
    <Style x:Key="PC_InfoChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,4,16,4" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Background" Value="{DynamicResource PC_ChipBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PC_ChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PC_InfoChipText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWeb}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
