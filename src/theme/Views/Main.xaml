<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!--
        Prism Console main view.
        The game rail's row, height and the hero panel position all come from the
        PC_* resources in Constants.xaml, so the same file serves the top, bottom
        and center rail variants.
    -->

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Selected game's background art, with scrims so text stays readable -->
                            <FadeImage x:Name="PART_ImageBackground" Grid.RowSpan="3"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Border Grid.RowSpan="3" Background="{DynamicResource PC_ScrimBrush}" IsHitTestVisible="False" />
                            <Border Grid.RowSpan="3" Background="{DynamicResource PC_SideScrimBrush}" IsHitTestVisible="False" />

                            <!-- ===== Top bar: system tabs + status ===== -->
                            <Grid Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}" Height="104">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <FilterPresetSelector x:Name="PART_FilterPresetSelector" Grid.Column="1"
                                                      VerticalAlignment="Center" Margin="0,0,40,0" />

                                <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="38"
                                                VerticalAlignment="Center" Margin="10,0,6,0"
                                                Grid.Column="2">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource GlyphLightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <TextBlock x:Name="PART_TextBatteryPercentage" Style="{DynamicResource TextBlockBaseStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"
                                           Grid.Column="3"/>

                                <TextBlock x:Name="PART_TextClock" Style="{DynamicResource TextBlockBaseStyle}"
                                           FontFamily="{DynamicResource FontTitilliumWeb}" FontSize="30"
                                           VerticalAlignment="Center" Margin="16,0,20,0"
                                           Grid.Column="4"/>

                                <ButtonEx x:Name="PART_ButtonProgramUpdate" VerticalAlignment="Center"
                                          Margin="8,0,8,0" Height="52" MinWidth="52"
                                          Style="{DynamicResource ButtonTopMenu}"
                                          Grid.Column="5">
                                    <ButtonEx.Content>
                                        <TextBlock Text="&#xef08;" FontFamily="{StaticResource FontIcoFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"
                                                   Foreground="{DynamicResource GlyphLightBrush}" FontSize="28" />
                                    </ButtonEx.Content>
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center"
                                          Margin="8,0,8,0" Height="52" MinWidth="52"
                                          Grid.Column="6">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="&#xeea3;" FontFamily="{StaticResource FontIcoFont}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"
                                                       Foreground="White" FontSize="28" />
                                            <TextBlock Text="&#x25CF;" Foreground="{DynamicResource GlyphBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       FontSize="20" Margin="0,-4,0,0" />
                                        </Grid>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonTopMenu}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center"
                                          Style="{DynamicResource ButtonTopMenu}"
                                          Margin="8,0,0,0" Height="52" MinWidth="52"
                                          Grid.Column="7">
                                    <Button.Content>
                                        <Image RenderOptions.BitmapScalingMode="Fant" Margin="6"
                                               Source="{ThemeFile 'Images/applogo_clean.png'}" />
                                    </Button.Content>
                                </ButtonEx>

                                <!-- Rainbow hairline under the top bar -->
                                <Border Grid.ColumnSpan="9" Height="2" VerticalAlignment="Bottom" Opacity="0.55"
                                        Background="{DynamicResource PC_AccentLineBrush}" Margin="70,0,70,0" />
                            </Grid>

                            <!-- ===== Content: filters on the left, hero + rail on the right ===== -->
                            <DockPanel Grid.Row="1">
                                <Filters x:Name="PART_ElemFilters"
                                         DockPanel.Dock="Left" Focusable="False" />

                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional"
                                                   DockPanel.Dock="Left" Focusable="False" />

                                <ContentControl x:Name="PART_ContentFilterItems"
                                                DockPanel.Dock="Left" Focusable="False" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Hero: what is selected right now -->
                                    <StackPanel Grid.Row="{DynamicResource PC_HeroRow}"
                                                Margin="{DynamicResource PC_HeroMargin}"
                                                VerticalAlignment="{DynamicResource PC_HeroVerticalAlignment}"
                                                HorizontalAlignment="Left"
                                                DataContext="{Binding SelectedGame}">
                                        <ContentControl Style="{DynamicResource PC_PlatformLogo}"
                                                        Height="64" HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontFamily="{DynamicResource FontTitilliumWebBold}"
                                                   FontSize="{DynamicResource PC_HeroTitleSize}"
                                                   Foreground="White" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="1400">
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="Black"
                                                                  Opacity="0.9" RenderingBias="Quality" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                    Visibility="{DynamicResource PC_HeroDetailsVisibility}">
                                            <Border x:Name="ChipInstalled">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource PC_InfoChip}">
                                                        <Setter Property="Background" Value="#3D3DFFA2" />
                                                        <Setter Property="BorderBrush" Value="#AA3DFFA2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{DynamicResource PC_InfoChipText}"
                                                           Text="{DynamicResource LOCGameIsInstalledTitle}" />
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource PC_InfoChip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReleaseYear}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{DynamicResource PC_InfoChipText}" Text="{Binding ReleaseYear}" />
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource PC_InfoChip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Genres.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Genres}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{DynamicResource PC_InfoChipText}" MaxWidth="520"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Genres, Converter={StaticResource ListToStringConverter}}" />
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource PC_InfoChip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Playtime}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{DynamicResource PC_InfoChipText}"
                                                           Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}" />
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource PC_InfoChip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastActivity}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{DynamicResource PC_InfoChipText}"
                                                           Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- The game rail -->
                                    <DockPanel Grid.Row="{DynamicResource PC_RailRow}"
                                               Margin="{DynamicResource PC_RailMargin}"
                                               VerticalAlignment="{DynamicResource PC_RailVerticalAlignment}">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="30,0,0,6">
                                            <Border Width="6" CornerRadius="3" Margin="0,4,12,4"
                                                    Background="{DynamicResource SelectionBrush}" />
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebBold}" />
                                                        <Setter Property="FontSize" Value="24" />
                                                        <Setter Property="Text" Value="{Binding ActiveFilterPreset.Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveFilterPreset}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{DynamicResource LOCAllGames}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="22"
                                                       Foreground="{DynamicResource TextBrushDark}" VerticalAlignment="Center"
                                                       Margin="14,0,0,0"
                                                       Text="{Binding Items.Count, ElementName=PART_ListGameItems}" />
                                        </StackPanel>
                                        <ListBoxEx x:Name="PART_ListGameItems"
                                                   Height="{DynamicResource PC_RailHeight}"
                                                   Background="Transparent" BorderThickness="0"
                                                   KeyboardNavigation.DirectionalNavigation="Once" />
                                    </DockPanel>

                                    <TextBlock Grid.RowSpan="3" FontSize="40"
                                               Text="{DynamicResource LOCNoGamesFound}"
                                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>

                            <!-- ===== Bottom bar: controller hints + status ===== -->
                            <Grid Grid.Row="2" Background="{DynamicResource BottomBarBackgroundBrush}" Height="84">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ButtonEx x:Name="PART_ButtonInstall"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCInstallGame}" />
                                    <ButtonEx x:Name="PART_ButtonPlay"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCPlayGame}" />
                                    <ButtonEx x:Name="PART_ButtonDetails"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameDetails}" />
                                    <ButtonEx x:Name="PART_ButtonGameOptions"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameOptions}" />
                                    <ButtonEx x:Name="PART_ButtonSearch"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCSearchLabel}" />
                                    <ButtonEx x:Name="PART_ButtonFilter"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCFilter}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" x:Name="PART_ElemSearchActive"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontSize="16" TextAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextBrushDark}"
                                               Text="{DynamicResource LOCGameListSearchResults}"/>
                                    <TextBlock Foreground="White" TextAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" x:Name="PART_ElemExtraFilterActive"
                                           FontSize="20"
                                           VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                           TextAlignment="Center"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Foreground="{DynamicResource GlyphLightBrush}"
                                           Text="{DynamicResource LOCGameListExtraFiltered}"/>

                                <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal"
                                            Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="PART_TextProgressTooltip"
                                               Margin="0,0,15,0" FontSize="20" VerticalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"/>
                                    <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                    Height="36" Width="36" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <GameStatus x:Name="PART_ElemGameStatus" Grid.RowSpan="3"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
