<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <!--
        Prism Console
        All colors and layout knobs live in this file. The block between the
        RAIL LAYOUT markers is rewritten by tools/build.py for each variant
        (top, bottom, center). Edit src/variants.json to tweak a variant.
    -->

    <!-- ===== RAIL LAYOUT (generated per variant) ===== -->
    <!-- Content grid has three rows: 0 = top slot, 1 = middle (fills), 2 = bottom slot -->
    <sys:String x:Key="PC_RailPosition">Bottom</sys:String>
    <sys:Int32 x:Key="PC_RailRow">2</sys:Int32>
    <sys:Int32 x:Key="PC_HeroRow">1</sys:Int32>
    <sys:Double x:Key="PC_RailHeight">330</sys:Double>
    <Thickness x:Key="PC_RailMargin">80,10,80,24</Thickness>
    <VerticalAlignment x:Key="PC_RailVerticalAlignment">Bottom</VerticalAlignment>
    <VerticalAlignment x:Key="PC_HeroVerticalAlignment">Bottom</VerticalAlignment>
    <Thickness x:Key="PC_HeroMargin">110,20,110,10</Thickness>
    <sys:Double x:Key="PC_HeroTitleSize">60</sys:Double>
    <Visibility x:Key="PC_HeroDetailsVisibility">Visible</Visibility>
    <!-- ===== END RAIL LAYOUT ===== -->

    <!-- Small platform logo chip on each game tile. Set to Collapsed to hide. -->
    <Visibility x:Key="PC_TilePlatformBadgeVisibility">Visible</Visibility>

    <!-- ===== Palette ===== -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>

    <!-- Accent: hot magenta to electric cyan -->
    <Color x:Key="GlyphColor">#FFFF3D9A</Color>
    <Color x:Key="GlyphLightColor">#FF2EE6FF</Color>
    <Color x:Key="AccentPurpleColor">#FF8B5CFF</Color>
    <Color x:Key="AccentYellowColor">#FFFFD23F</Color>
    <Color x:Key="AccentGreenColor">#FF3DFFA2</Color>
    <Color x:Key="AccentOrangeColor">#FFFF8A3D</Color>

    <Color x:Key="SelectionLightColor">#FFB9C0E0</Color>
    <Color x:Key="OverlayColor">#CC05060F</Color>

    <Color x:Key="ControlBackgroundColor">#FF23264A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0E0F22</Color>

    <Color x:Key="TextColor">#FFF4F5FF</Color>
    <Color x:Key="TextColorDark">#FF8A8FB5</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <!-- Rotating colors for the system tabs in the top bar -->
    <SolidColorBrush x:Key="PC_Tab0Brush" Color="#FFFF3D9A" />
    <SolidColorBrush x:Key="PC_Tab1Brush" Color="#FF2EE6FF" />
    <SolidColorBrush x:Key="PC_Tab2Brush" Color="#FFFFD23F" />
    <SolidColorBrush x:Key="PC_Tab3Brush" Color="#FF3DFFA2" />
    <SolidColorBrush x:Key="PC_Tab4Brush" Color="#FF8B5CFF" />
    <SolidColorBrush x:Key="PC_Tab5Brush" Color="#FFFF8A3D" />
    <SolidColorBrush x:Key="PC_Tab6Brush" Color="#FF4D8BFF" />

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">320</sys:Double>

    <GridLength x:Key="ProgressWindowWidth">640</GridLength>

    <sys:Double x:Key="PC_TileCornerRadiusValue">14</sys:Double>
    <CornerRadius x:Key="PC_TileCornerRadius">14</CornerRadius>

    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebLight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Deep space backdrop with a soft color bloom -->
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.2,0.0" Center="0.3,0.1" RadiusX="1.0" RadiusY="1.2">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF2A1452" Offset="0" />
            <GradientStop Color="#FF12123A" Offset="0.45" />
            <GradientStop Color="#FF07081A" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <!-- Keeps text readable over game backgrounds -->
    <LinearGradientBrush x:Key="PC_ScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC07081A" Offset="0"/>
        <GradientStop Color="#3307081A" Offset="0.35"/>
        <GradientStop Color="#5507081A" Offset="0.6"/>
        <GradientStop Color="#EE07081A" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PC_SideScrimBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#AA07081A" Offset="0"/>
        <GradientStop Color="#0007081A" Offset="0.6"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E607081A" Offset="0"/>
        <GradientStop Color="#0007081A" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0007081A" Offset="0"/>
        <GradientStop Color="#F007081A" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0,0" EndPoint="1,1" >
        <GradientStop Color="#F21A1240" Offset="0"/>
        <GradientStop Color="#F207081A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Focus ring and highlights -->
    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0,0" EndPoint="1,1" >
        <GradientStop Color="{DynamicResource GlyphColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentPurpleColor}" Offset="0.5"/>
        <GradientStop Color="{DynamicResource GlyphLightColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PC_AccentLineBrush" StartPoint="0,0" EndPoint="1,0" >
        <GradientStop Color="#FFFF3D9A" Offset="0"/>
        <GradientStop Color="#FFFFD23F" Offset="0.25"/>
        <GradientStop Color="#FF3DFFA2" Offset="0.5"/>
        <GradientStop Color="#FF2EE6FF" Offset="0.75"/>
        <GradientStop Color="#FF8B5CFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4" >
        <GradientStop Color="#0007081A" Offset="0.0"/>
        <GradientStop Color="#F007081A" Offset="0.8"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PC_ChipBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="PC_ChipBorderBrush" Color="#44FFFFFF" />

    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />
</ResourceDictionary>
